# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection
MONGODB_URI=mongodb://localhost:27017/myrotapro

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-here
JWT_EXPIRES_IN=7d

# Email Configuration (for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
# Sender for transactional email (password reset links). Unset SMTP = emails are logged, not sent.
EMAIL_FROM=MyRotaPro <noreply@example.com>
# Public app URL used in password reset links (defaults to the first CORS origin)
FRONTEND_URL=http://localhost:3000

# AI Solver Configuration
AI_SOLVER_TIMEOUT=30000
AI_SOLVER_MAX_ITERATIONS=1000
